APP_NAME=StatusConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8070

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=statusconnect
DB_USERNAME=statusconnect
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@statusconnect.local"
MAIL_FROM_NAME="${APP_NAME}"

TARGET_URL=http://target:8080

CHECK_CONCURRENCY=10
CHECK_TARGET_DURATION_SECONDS=45
CHECK_CLAIM_TTL_MINUTES=5
CHECK_WAVE_SIZE=10
# A tick this many minutes after the previous one records a checker gap and emails
# the platform admins; /v1/platform/health?checker=1 answers 503 past it.
CHECKER_GAP_MINUTES=3
# Saturation alert: CHECKER_SATURATION_TICKS ticks in a row that leave
# due monitors behind or run CHECKER_SATURATION_SECONDS or longer email the
# platform admins (at most every CHECKER_SATURATION_ALERT_HOURS).
CHECKER_SATURATION_SECONDS=30
CHECKER_SATURATION_TICKS=3
CHECKER_SATURATION_ALERT_HOURS=6
# Checks per tick measured with `php artisan monitor:capacity-test`; shown in
# the platform console against current demand. Empty = not measured.
CHECKER_CAPACITY_PER_MINUTE=
CHECK_MAX_TIMEOUT_MS=30000
FLAP_THRESHOLD=5
FLAP_WINDOW_MINUTES=60
STATUS_PAGE_PUBLIC_RATE_LIMIT_PER_MINUTE=60

GRANDPASSON_OUTBOUND_ENABLED=false
GRANDPASSON_INBOUND_ENABLED=false
GRANDPASSON_BASE_URL=http://host.docker.internal:8080

APP_PORT=8070
MYSQL_PORT=3308
MAILPIT_UI_PORT=8035
MAILPIT_SMTP_PORT=1035
TARGET_PORT=8095
VITE_PORT=5173

# First-run setup (/app/setup): comma-separated emails allowed to create the first account.
# In production, setup is refused while this is empty.
SETUP_ALLOWED_EMAILS=

# Agent metric ingestion (Telegraf / OpenTelemetry), docs/specs/agent-ingestion-addendum.md §7.
# Off by default: with the flag off, /ingest routes answer 404 and kind=agent cannot be created.
AGENT_INGEST_ENABLED=false
# Request body as received, in bytes.
AGENT_INGEST_MAX_BYTES=262144
# Request body after gzip decompression, in bytes (zip-bomb guard).
AGENT_INGEST_MAX_DECOMPRESSED_BYTES=1048576
# Line protocol lines or OTLP data points per request.
AGENT_INGEST_MAX_LINES=2000
# OTLP: resource attributes copied into metric keys, and the most data point attributes per key.
AGENT_OTLP_RESOURCE_ATTRIBUTES=host.name,service.name
AGENT_OTLP_MAX_ATTRIBUTES=8
# Ingestion requests per minute, per token and per client IP.
AGENT_INGEST_RATE_PER_TOKEN_PER_MINUTE=12
AGENT_INGEST_RATE_PER_IP_PER_MINUTE=60
# Distinct metrics kept per agent monitor; new metrics above this are dropped and counted.
AGENT_MAX_METRICS_PER_MONITOR=200
# Threshold rules per agent monitor.
AGENT_MAX_RULES_PER_MONITOR=50
# Maximum canonical metric key length (measurement.field{tags}).
AGENT_METRIC_KEY_MAX_LENGTH=255
# Days a metric may go without updates before monitor:maintenance deletes it.
RETENTION_AGENT_METRIC_DAYS=30

# Terms of Use (/termos, English /terms) and Privacy Policy (/privacidade, English /privacy). Fill in the data of whoever
# operates this instance; empty values render neutral wording. The texts are templates:
# have them reviewed by a lawyer before offering the service to the public.
LEGAL_COMPANY_NAME=
# CNPJ
LEGAL_COMPANY_ID=
LEGAL_ADDRESS=
# Contact / encarregado (DPO) e-mail. Empty uses MAIL_FROM_ADDRESS.
LEGAL_CONTACT_EMAIL=
# Court district (comarca), e.g. "São Paulo/SP"
LEGAL_FORUM=
LEGAL_WEBSITE=
# Shown as "Última atualização", e.g. 2026-11-18
LEGAL_UPDATED_AT=
# Version users accept when LEGAL_REQUIRE_ACCEPTANCE=true. Empty = LEGAL_UPDATED_AT. Set it to the previous
# date to move LEGAL_UPDATED_AT without asking everyone to accept again.
LEGAL_ACCEPTANCE_VERSION=
# Hosting provider named as a data processor, e.g. "Your Hosting Ltd."
LEGAL_HOSTING_PROVIDER=
# Where the server is, completing "hospedado ...": e.g. "nos Estados Unidos" or "no Brasil". Shown on the landing page and in the legal pages.
LEGAL_HOSTING_LOCATION=
# The same in English for /terms and /privacy, e.g. "in the United States". Empty: Brazil and the United States are recognised.
LEGAL_HOSTING_LOCATION_EN=
# true: every signed-in user must accept the current texts (version = LEGAL_UPDATED_AT; change it to ask everyone again).
LEGAL_REQUIRE_ACCEPTANCE=false

# Sign in with Google. Off by default. The legal pages describe it as soon as GOOGLE_CLIENT_ID
# is set, so Google can review them before the consent screen is published.
# Guide: docs/integrations/google-login.md
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty uses APP_URL/auth/google/callback; must match the redirect URI registered in Google Cloud.
GOOGLE_REDIRECT_URI=

# Second-location confirmation: before a failure opens an incident, ask
# another location to repeat the check. Off by default. If no provider answers
# in time, the incident opens as before. Guide: docs/deployment/second-location.md
SECOND_LOCATION_ENABLED=false
SECOND_LOCATION_PROVIDERS=probe,globalping
SECOND_LOCATION_MAX_PER_TICK=10
SECOND_LOCATION_COOLDOWN_SECONDS=300
# The probe in probe/ (any PHP host or container in another location). Secret: openssl rand -hex 32
SECOND_LOCATION_PROBE_URL=
SECOND_LOCATION_PROBE_SECRET=
SECOND_LOCATION_PROBE_TIMEOUT=12
# Named in the Privacy Policy when the feature is on, e.g. "Google Cloud, em São Paulo".
SECOND_LOCATION_PROBE_HOST_LABEL=
# Globalping (https://globalping.io). The token is optional (raises the hourly limit).
GLOBALPING_TOKEN=
GLOBALPING_LOCATION=BR
GLOBALPING_TIMEOUT=10

# Plans. The Community Edition has one plan, "unlimited", with no limits.
PLAN_DEFAULT=unlimited

# Public sign-up: closed | approval | open.
SIGNUP_MODE=closed
SIGNUP_LOCALE=pt_BR
SIGNUP_TIMEZONE=America/Sao_Paulo
# Extra disposable email domains to refuse, comma separated.
SIGNUP_BLOCKED_DOMAINS=

# Status page email subscriptions.
# Emails per minute-cron run across all pages; keep it under the SMTP provider's limits.
STATUS_PAGE_SUBSCRIBER_MAIL_PER_MINUTE=20
STATUS_PAGE_SUBSCRIBER_NEW_PER_HOUR=30
STATUS_PAGE_SUBSCRIBER_MAX_PER_PAGE=5000
STATUS_PAGE_SUBSCRIBER_CONFIRMATION_HOURS=48

# Telegram notification channel (docs/integrations/telegram.md). One bot per installation,
# created in BotFather. Empty token: the telegram channel type is not offered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random, 32+ characters; protects the webhook Telegram calls.
TELEGRAM_WEBHOOK_SECRET=
